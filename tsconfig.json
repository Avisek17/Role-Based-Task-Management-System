{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["node", "jest"],

    "sourceMap": true,
    "skipLibCheck": true,

    "verbatimModuleSyntax": false
  },

  "include": ["src/**/*.ts"]
}