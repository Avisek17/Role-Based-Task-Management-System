<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Tasks</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

    <div class="container">

        <header>

            <div>

                <h1>Task Manager</h1>

                <p>
                    Welcome,
                    <strong>
                        <%= username %>
                    </strong>
                </p>

                <p>
                    Role:
                    <strong>
                        <%= role %>
                    </strong>
                </p>

            </div>

            <div>

                <% if (role === "admin") { %>

                    <a href="/admin">
                        Admin Dashboard
                    </a>

                <% } %>

                <form
                    action="/auth/logout"
                    method="POST"
                    class="inline-form"
                >

                    <button type="submit">
                        Logout
                    </button>

                </form>

            </div>

        </header>

        <hr>

        <a href="/tasks/new">
            <button>
                Add New Task
            </button>
        </a>

        <h2>My Tasks</h2>

        <% if (tasks.length === 0) { %>

            <p>
                You don't have any tasks yet.
            </p>

        <% } %>

        <% tasks.forEach(task => { %>

            <div class="task-card">

                <h3>
                    <%= task.title %>
                </h3>

                <p>
                    <%= task.description %>
                </p>

                <p>

                    Status:

                    <% if (task.completed) { %>

                        <strong>
                            Completed
                        </strong>

                    <% } else { %>

                        <strong>
                            Pending
                        </strong>

                    <% } %>

                </p>

                <a
                    href="/tasks/<%= task.id %>/edit"
                >
                    Edit
                </a>

                <form
                    action="/tasks/<%= task.id %>/complete"
                    method="POST"
                    class="inline-form"
                >

                    <button type="submit">

                        <%= task.completed
                            ? "Mark Pending"
                            : "Complete"
                        %>

                    </button>

                </form>

                <form
                    action="/tasks/<%= task.id %>/delete"
                    method="POST"
                    class="inline-form"
                >

                    <button type="submit">
                        Delete
                    </button>

                </form>

            </div>

        <% }) %>

    </div>

</body>

</html>