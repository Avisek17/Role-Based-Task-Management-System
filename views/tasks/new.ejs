<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <title>Create Task</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <h1>Create Task</h1>

        <a href="/tasks">
            ← Back to Tasks
        </a>
    </header>

    <main>

        <form
            action="/tasks"
            method="POST"
        >

            <label for="title">
                Title
            </label>

            <input
                type="text"
                id="title"
                name="title"
                required
            >

            <label for="description">
                Description
            </label>

            <textarea
                id="description"
                name="description"
                required
            ></textarea>

            <button type="submit">
                Create Task
            </button>

        </form>

    </main>

</body>

</html>